# Database Configuration
DATABASE_URL=postgresql+asyncpg://ai_platform:ai_platform_password@postgres:5432/ai_platform_db

# Redis Configuration
REDIS_URL=redis://redis:6379/0

# OpenAI Configuration
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-3.5-turbo

# Application Settings
APP_NAME=AI Data Analysis Platform
APP_VERSION=1.0.0
DEBUG=True
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE=104857600  # 100MB in bytes

# Server Configuration
HOST=0.0.0.0
PORT=8000

# Cache Configuration
CACHE_TTL=3600  # 1 hour in seconds
ENABLE_CACHE=True

# LLM Configuration
LLM_TEMPERATURE=0.0
LLM_MAX_TOKENS=2000
AGENT_MAX_ITERATIONS=10
AGENT_VERBOSE=True
